from PIL import Image, ImageDraw

# Create a 256x256 image
W = H = 256
img = Image.new("RGBA", (W, H), (245, 245, 245, 255))
draw = ImageDraw.Draw(img)

purple = (156, 74, 170, 255)

# Large main outline shape
# Draw a big rounded-rectangle-like shape
draw.rounded_rectangle(
    [36, 50, 220, 204],
    radius=20,
    outline=purple,
    width=4,
    fill=(0, 0, 0, 0)
)

# Top and side lines to match the sketch more closely
draw.line((48, 58, 112, 58), fill=purple, width=4)
draw.line((114, 58, 186, 58), fill=purple, width=4)
draw.line((188, 58, 206, 58), fill=purple, width=4)

draw.line((66, 88, 66, 166), fill=purple, width=4)
draw.line((66, 166, 120, 166), fill=purple, width=4)
draw.line((120, 166, 180, 166), fill=purple, width=4)
draw.line((180, 166, 196, 166), fill=purple, width=4)

# Left little block
draw.rounded_rectangle([78, 106, 130, 156], radius=6, outline=purple, width=3, fill=(0,0,0,0))
draw.line((90, 126, 118, 126), fill=purple, width=3)
draw.line((104, 108, 104, 154), fill=purple, width=3)

# Right little block
draw.rounded_rectangle([156, 106, 206, 156], radius=6, outline=purple, width=3, fill=(0,0,0,0))
draw.line((168, 126, 194, 126), fill=purple, width=3)
draw.line((181, 108, 181, 154), fill=purple, width=3)

# Inner center area
draw.rounded_rectangle([90, 110, 170, 146], radius=8, outline=purple, width=3, fill=(0,0,0,0))

# A few small extra features like the sketch
draw.line((152, 96, 152, 112), fill=purple, width=3)
draw.line((110, 96, 110, 112), fill=purple, width=3)
draw.line((80, 96, 80, 112), fill=purple, width=3)
draw.line((180, 92, 180, 110), fill=purple, width=3)

# Save as real PNG file
img.save("icon.png")
print("Created: icon.png")
